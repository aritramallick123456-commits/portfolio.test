.steps{margin-top:60px}.step{padding:38px 0;gap:28px}.step p{line-height:1.75}
.grid2{gap:clamp(48px,7vw,92px)}.about p{margin-top:32px;line-height:1.8}.tools{gap:22px}.tool{padding:28px}
.btns{margin-top:56px;display:flex;flex-direction:column;align-items:flex-start;gap:16px}.btn{padding:12px 22px 12px 16px;border-radius:14px;gap:12px;min-width:min(100%,290px)}.btn svg{width:24px;height:24px}.btn b{font-size:1.25rem}.btn small{font-size:.82rem}footer{margin-top:80px}
/* pinned horizontal work */
.pin{padding:0;height:300vh}
.stick{position:sticky;top:0;height:100vh;display:flex;flex-direction:column;justify-content:center;gap:clamp(24px,5vh,48px);overflow:hidden;padding-top:72px}
.stick .hint{margin-top:16px}
.rail{display:flex;gap:clamp(24px,3vw,40px);overflow:visible;scroll-snap-type:none;padding:0 clamp(24px,5vw,56px);width:max-content;max-width:none;will-change:transform}
.work{flex:0 0 auto}.art{aspect-ratio:auto;height:min(48vh,420px);width:min(72vw,calc(min(48vh,420px)*.82))}
