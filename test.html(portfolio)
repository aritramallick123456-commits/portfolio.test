@media(prefers-reduced-motion:reduce){*{animation:none!important;scroll-behavior:auto!important}}
.work{position:relative}.art.has>*{display:none}
.cv{position:absolute;top:10px;right:10px;z-index:5;background:var(--yellow);color:var(--navy);border:0;border-radius:99px;padding:6px 12px;font:700 .75rem var(--b);cursor:pointer;display:none}.own .cv{display:block}
.gm{position:fixed;inset:0;z-index:90;background:rgba(16,18,79,.95);display:none;overflow:auto;padding:84px clamp(24px,5vw,64px) 60px;color:#fff}.gm.on{display:block}
.gh{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:32px}.gh h3{font-size:clamp(2.4rem,6vw,4.5rem)}.gh small{opacity:.7;display:block;margin-bottom:6px}
.gx{position:fixed;top:calc(16px + env(safe-area-inset-top,0px));right:clamp(24px,5vw,64px);z-index:91;background:var(--yellow);color:var(--navy);border:0;border-radius:99px;padding:10px 18px;font:700 .9rem var(--b);cursor:pointer}
.gt{display:none;gap:10px}.own .gt{display:flex}.gt button{background:transparent;color:#fff;border:1.5px solid #fff;border-radius:99px;padding:8px 16px;font:500 .85rem var(--b);cursor:pointer}.gt button:hover{background:#fff;color:var(--navy)}
.gg{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr));gap:18px}
.gi{position:relative;border-radius:10px;overflow:hidden;aspect-ratio:4/5;background:rgba(255,255,255,.08)}.gi img{width:100%;height:100%;object-fit:cover;display:block}
.gi button{position:absolute;top:8px;right:8px;display:none;background:var(--coral);color:#fff;border:0;border-radius:99px;padding:5px 12px;font:700 .75rem var(--b);cursor:pointer}.own .gi button{display:block}
.ge{opacity:.8;font-size:1.1rem;max-width:480px}
.eyebrow{display:block;font:700 .8rem var(--b);letter-spacing:.12em;text-transform:uppercase;color:currentColor;opacity:.8;margin-bottom:18px}#process .eyebrow{color:var(--yellow);opacity:1}
.lede{max-width:540px;margin-top:22px;font-size:1.15rem;line-height:1.7;opacity:.85}
.steps{margin-top:56px}.step{grid-template-columns:70px 1fr}.step em{font:700 .95rem var(--b);letter-spacing:.1em;padding-top:.9rem}.step h3{font-size:clamp(2rem,3.4vw,2.8rem)}.step p{font-size:1.05rem;max-width:560px;margin-top:10px;opacity:.85}
h2+.lede{margin-top:8px}#work .lede{font-size:1rem;opacity:.7}#hero .eyebrow{position:relative;z-index:3;animation:up 1s backwards}
.hcta{position:relative;z-index:3;margin-top:36px;display:flex;gap:14px;flex-wrap:wrap;animation:up 1s .75s backwards}.ghost{border:1.5px solid #fff;color:#fff;padding:10px 22px;border-radius:99px;font-weight:700;text-decoration:none;transition:background .2s,color .2s}.ghost:hover{background:#fff;color:var(--navy)}
.pcta{margin-top:56px;display:flex;align-items:center;gap:24px;flex-wrap:wrap}.pcta p{font:400 clamp(1.5rem,3vw,2.4rem)/1.1 var(--d);text-transform:uppercase}
</style>
