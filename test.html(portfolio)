header{transition:background .3s}header.sc{background:rgba(16,18,79,.93);backdrop-filter:blur(8px)}
nav a:not(.pill){position:relative}nav a:not(.pill)::after{content:'';position:absolute;left:0;bottom:-4px;height:2px;width:0;background:var(--yellow);transition:width .25s}nav a:not(.pill):hover::after{width:100%}nav a:hover{text-decoration:none}

/* hero */
#hero{background:var(--blue);color:#fff;min-height:100vh;display:flex;align-items:center;overflow:hidden;padding:120px 0 90px}
#hero h1{font-size:clamp(3rem,9.5vw,8.5rem);position:relative;z-index:3;max-width:1100px}
#hero p.lead{position:relative;z-index:3;max-width:480px;margin-top:28px;font-size:1.1rem}
.tags{position:relative;z-index:3;margin-top:22px;display:flex;gap:10px;flex-wrap:wrap}
.tags span{border:1.5px solid rgba(255,255,255,.6);border-radius:99px;padding:6px 16px;font-size:.9rem}
.sh{position:absolute;z-index:2;animation:fl 7s ease-in-out infinite alternate}
@keyframes fl{to{transform:translateY(-28px) rotate(18deg)}}
.c{border-radius:50%}
.ring{border-radius:50%;border:26px solid #fff}
.tri{width:0;height:0;border-left:34px solid transparent;border-right:34px solid transparent;border-bottom:60px solid var(--pink)}
.half{border-radius:100px 100px 0 0;background:var(--yellow)}
.sq{transform:rotate(14deg);border-radius:8px}

/* services */
#services{background:var(--coral);color:#fff}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:20px;margin-top:56px}
.card{border:1.5px solid rgba(255,255,255,.55);border-radius:18px;padding:26px;min-height:300px;display:flex;flex-direction:column;justify-content:space-between}
.card h3{font-size:2.2rem;margin-top:22px}
.card p{font-size:.95rem;margin-top:10px}
.card .ic{width:84px;height:84px}

/* works */
#work{background:var(--cream)}
.rail{display:flex;gap:22px;overflow-x:auto;padding:50px 24px 24px;scroll-snap-type:x mandatory;max-width:100%}
.work{flex:0 0 min(78vw,440px);scroll-snap-align:start;text-decoration:none}
.art{aspect-ratio:4/5;border-radius:20px;position:relative;overflow:hidden;display:flex;align-items:flex-end;padding:22px}
.art b{font-family:var(--d);font-weight:400;font-size:2.8rem;line-height:.95;text-transform:uppercase;position:relative;z-index:2}
.art .s{position:absolute}
.meta{display:flex;justify-content:space-between;padding:14px 4px;font-weight:500}
.hint{font-size:.9rem;opacity:.7;margin-top:12px}

/* process */
#process{background:var(--navy);color:#fff}
.steps{margin-top:56px;display:grid;gap:0}
.step{display:grid;grid-template-columns:90px 1fr;gap:20px;padding:30px 0;border-top:1.5px solid rgba(255,255,255,.25)}
.step em{font-family:var(--d);font-style:normal;font-size:3rem;color:var(--yellow)}
.step h3{font-size:2.4rem}.step p{max-width:520px;margin-top:8px;opacity:.85}

/* about / tools */
#about{background:var(--blue);color:#fff}
.grid2{display:grid;grid-template-columns:1.1fr 1fr;gap:56px;align-items:start}
@media(max-width:820px){.grid2{grid-template-columns:1fr}}
.about p{font-size:1.15rem;margin-top:26px;max-width:540px}
.tools{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.tool{border:1.5px solid rgba(255,255,255,.5);border-radius:16px;padding:22px;font-family:var(--d);font-size:1.6rem;text-transform:uppercase}
.tool small{display:block;font:400 .85rem var(--b);text-transform:none;opacity:.8;margin-top:4px}
.ticker{background:var(--yellow);color:var(--navy);overflow:hidden;white-space:nowrap;padding:16px 0;font-family:var(--d);font-size:2rem;text-transform:uppercase}
.ticker div{display:inline-block;animation:tk 26s linear infinite}
@keyframes tk{to{transform:translateX(-50%)}}

/* contact */
#contact{background:var(--yellow);color:var(--navy);padding-bottom:70px}
#contact h2{font-size:clamp(3.2rem,11vw,10rem)}
.cl{margin-top:44px;display:grid;gap:0}
.cl a{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:22px 0;border-top:2px solid var(--navy);text-decoration:none;font-family:var(--d);font-size:clamp(1.3rem,3.4vw,2.6rem);text-transform:uppercase;word-break:break-all}
.cl a:last-child{border-bottom:2px solid var(--navy)}
.cl a span{font:500 .9rem var(--b);text-transform:none;flex:none}
.cl a:hover{padding-left:12px;background:var(--navy);color:var(--yellow)}
footer{margin-top:50px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:.9rem}
@keyframes up{from{opacity:0;transform:translateY(40px)}}
