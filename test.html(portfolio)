<script>
const $=s=>document.querySelector(s),hd=$('header');
addEventListener('scroll',()=>hd.classList.toggle('sc',scrollY>60),{passive:true});
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});
document.querySelectorAll('h2,.card,.step,.tool,.btn,.hint').forEach((el,i)=>{el.classList.add('rv');el.style.setProperty('--dl',(i%4)*.09+'s');io.observe(el)});
const sh=[...document.querySelectorAll('.sh')];
$('#hero').addEventListener('mousemove',e=>{const x=e.clientX/innerWidth-.5,y=e.clientY/innerHeight-.5;sh.forEach((s,i)=>{const k=(i%3+1)*18;s.style.translate=(x*k)+'px '+(y*k)+'px'})});
const rm=matchMedia('(prefers-reduced-motion:reduce)'),pins=[['#work','#rail','#bar']].map(([a,b,c])=>({pin:$(a),rail:$(b),bar:$(c)}));
const VH=()=>$('#vh').offsetHeight||innerHeight;let lw=innerWidth;
function setH(){if(rm.matches)return;pins.forEach(o=>{const d=Math.max(o.rail.scrollWidth-innerWidth,0);o.d=d;o.pin.style.height=(VH()+d*1.15)+'px'})}
function upd(){if(rm.matches)return;pins.forEach(o=>{const r=o.pin.getBoundingClientRect(),p=Math.min(1,Math.max(0,-r.top/((o.d||1)*1.15)));o.rail.style.transform='translateX('+(-p*o.d)+'px)';o.bar.style.width=(p*100)+'%';})}
setH();upd();addEventListener('load',()=>{setH();upd()});addEventListener('resize',()=>{if(innerWidth!==lw){lw=innerWidth;setH()}upd()});addEventListener('scroll',upd,{passive:true});
const topOf=t=>Math.round(t.getBoundingClientRect().top+scrollY);
document.querySelectorAll('a[href^="#"]').forEach(a=>a.addEventListener('click',e=>{const id=a.getAttribute('href'),t=id.length>1&&document.querySelector(id);if(!t)return;e.preventDefault();scrollTo({top:topOf(t),behavior:'smooth'});clearTimeout(window._sc);window._sc=setTimeout(()=>{if(Math.abs(topOf(t)-scrollY)>4)scrollTo({top:topOf(t),behavior:'auto'})},1400);history.replaceState(null,'',id)}));
const PROJECTS={p:[{c:'',g:[]},{c:'',g:[]},{c:'',g:[]},{c:'',g:[]}]};
const $$=s=>[...document.querySelectorAll(s)],ST=PROJECTS,works=$$('.work'),U=id=>id;let cur=0,A=null,S=null;
function paint(){works.forEach((w,i)=>{const a=w.querySelector('.art'),c=ST.p[i].c;a.classList.toggle('has',!!c);a.style.background=c?`url(${U(c)}) center/cover`:''})}
function drawG(){const g=ST.p[cur].g,box=$('#gg');box.textContent='';g.forEach((id,k)=>{const d=document.createElement('div');d.className='gi';const im=new Image();im.src=U(id);im.alt='Design '+(k+1);d.append(im);const b=document.createElement('button');b.type='button';b.textContent='Remove';b.onclick=()=>{ST.p[cur].g.splice(k,1);save()};d.append(b);box.append(d)});$('#ge').hidden=g.length>0}
function openG(i){cur=i;const w=works[i];$('#gt').textContent=w.querySelector('b').textContent.replace(/\s+/g,' ');$('#gs').textContent=w.querySelector('.meta span').textContent;drawG();$('#gm').classList.add('on');document.body.style.overflow='hidden'}
function closeG(){$('#gm').classList.remove('on');document.body.style.overflow=''}
works.forEach((w,i)=>{w.addEventListener('click',e=>{e.preventDefault();openG(i)});const b=document.createElement('button');b.type='button';b.className='cv';b.textContent='Change cover';b.onclick=e=>{e.preventDefault();e.stopPropagation();cur=i;$('#fc').click()};w.append(b)});
$('#gx').onclick=closeG;addEventListener('keydown',e=>{if(e.key==='Escape')closeG()});paint();
async function save(){try{toast('Saving…');const b64=$('#tpl').textContent.trim(),T=new TextDecoder().decode(Uint8Array.from(atob(b64),c=>c.charCodeAt(0)));const doc=T.replace('<!--'+'TPL-->',()=>'<script type="text/plain" id="tpl">'+b64+'<\/script>').replace('<!--'+'STATE-->',()=>'<script type="application/json" id="state">'+JSON.stringify(ST)+'<\/script>');await S.publish(doc)}catch(e){toast('Could not save. Please try again.')}}
$('#fc').onchange=async function(){const f=this.files[0];this.value='';if(!f||!A)return;try{toast('Uploading…');const r=await A.upload(f);ST.p[cur].c=r.id;await save()}catch(e){toast('Upload failed')}};
$('#fg').onchange=async function(){const fs=[...this.files];this.value='';if(!fs.length||!A)return;try{toast('Uploading…');for(const f of fs){const r=await A.upload(f);ST.p[cur].g.push(r.id)}await save()}catch(e){toast('Upload failed')}};
$('#ga').onclick=()=>$('#fg').click();$('#gr').onclick=()=>{ST.p[cur].c='';save()};
(async()=>{try{if(!window.claude||!claude.use)return;const usr=await claude.use('user');if(!usr||!usr.isOwner())return;A=await claude.use('assets');S=await claude.use('artifact');if(A&&S)document.body.classList.add('own')}catch(e){}})();
