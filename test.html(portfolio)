.js .rv{opacity:0}.js .rv.in{opacity:1;animation:up .8s var(--dl,0s) backwards}
.card,.tool,.art{transition:transform .3s,background .3s}.card:hover{transform:translateY(-8px) rotate(-1deg);background:rgba(255,255,255,.12)}.tool:hover{transform:scale(1.04);background:rgba(255,255,255,.12)}.work:hover .art{transform:scale(.97) rotate(-1deg)}
.step{transition:padding .3s}.step:hover{padding-left:16px}.step:hover em{color:#fff}
.btns{margin-top:44px;display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px}
.btn{display:flex;align-items:center;gap:16px;padding:22px 24px;border-radius:20px;background:var(--navy);color:#fff;text-decoration:none;border:0;cursor:pointer;text-align:left;font:inherit;transition:transform .2s,box-shadow .2s}
.btn:hover{transform:translateY(-5px);box-shadow:0 10px 0 rgba(16,18,79,.25)}.btn:active{transform:translateY(0)}
.btn svg{width:38px;height:38px;flex:none}.btn b{font-family:var(--d);font-weight:400;font-size:1.9rem;text-transform:uppercase;display:block;line-height:1}.btn small{font-size:.92rem;opacity:.85;word-break:break-all}
.btn.wa{background:#25d366;color:var(--navy)}.btn.copy{background:transparent;border:2.5px solid var(--navy);color:var(--navy)}
